+    esquema = chamar(url, "/schema")
+    assert esquema["quantidade_atributos"] == 57, esquema
+    assert esquema["alvo"] == "spam" and esquema["classe_positiva"] == 1, esquema
+    assert len(set(esquema["atributos"])) == 57, esquema
+    exemplos = {}
